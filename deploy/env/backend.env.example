# Copy to /etc/premium/backend.env (chmod 600, owner premium). Run `python -m app.cli gen-keys` for the secrets.
APP_ENV=production
APP_SECRET_KEY=
ENCRYPTION_KEY=
TIMEZONE=Asia/Tashkent
PUBLIC_BASE_URL=https://premium.example.uz
WEBAPP_URL=https://premium.example.uz

BOT_TOKEN=
BOT_USERNAME=
OWNER_TELEGRAM_ID=6190984042
WEBHOOK_SECRET=
LOG_CHAT_ID=
BOT_MODE=webhook

DATABASE_URL=postgresql+asyncpg://premium:CHANGE_ME@127.0.0.1:5432/premium
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

TON_NETWORK=mainnet
TONAPI_KEY=
TONCENTER_API_KEY=
HOT_WALLET_VERSION=v5r1
HOT_WALLET_MNEMONIC_FILE=/var/lib/premium/hot_wallet.enc
ADMIN_TON_ADDRESS=
ADMIN_TON_MEMO=

FRAGMENT_MODE=direct
FRAGMENT_API_KEY=
DEV_MOCK_PROVIDER=false
SENTRY_DSN=

# backups (optional): age public key to encrypt dumps; owner chat gets the file via the bot
BACKUP_DIR=/var/backups/premium
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAYS=14
